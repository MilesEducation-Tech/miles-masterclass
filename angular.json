{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "schematics": {
    "@schematics/angular": {}
  },
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "analytics": "993e7c12-4e32-4829-8dc2-ca1c81619a16",
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "miles-masterclass-v3": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/miles-masterclass-v3",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              "src/.well-known/assetlinks.json",
              "src/.well-known/apple-app-site-association"
            ],
            "styles": ["src/styles/styles.css", "src/styles/animation.css"],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "ssr": {
              "entry": "src/server.ts"
            },
            "allowedCommonJsDependencies": [
              "core-js/modules/es.array.index-of.js",
              "core-js/modules/es.array.iterator.js",
              "core-js/modules/es.array.reduce.js",
              "core-js/modules/es.array.reverse.js",
              "core-js/modules/es.promise.js",
              "core-js/modules/es.regexp.to-string.js",
              "core-js/modules/es.string.ends-with.js",
              "core-js/modules/es.string.includes.js",
              "core-js/modules/es.string.match.js",
              "core-js/modules/es.string.replace.js",
              "core-js/modules/es.string.split.js",
              "core-js/modules/es.string.starts-with.js",
              "core-js/modules/es.string.trim.js",
              "core-js/modules/web.dom-collections.iterator.js",
              "@babel/runtime/helpers/extends",
              "@videojs/xhr",
              "@zoom/meetingsdk/embedded",
              "react",
              "react-dom",
              "react-dom/client",
              "@xmldom/xmldom",
              "global/document",
              "global/window",
              "jspdf",
              "jszip",
              "lie",
              "mux.js/lib/tools/parse-sidx",
              "mux.js/lib/utils/clock",
              "pako",
              "raf",
              "readable-stream",
              "rgbcolor",
              "setimmediate",
              "videojs-vtt.js",
              "videojs-youtube"
            ]
          },
          "configurations": {
            "production": {
              "optimization": true,
              "sourceMap": false,
              "aot": true,
              "extractLicenses": true,
              "namedChunks": false,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2MB",
                  "maximumError": "3MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "12kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "outputHashing": "all",
              "namedChunks": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.development.ts"
                },
                {
                  "replace": "src/app/core/interceptors/dev/dev-interceptors.ts",
                  "with": "src/app/testing/partner-mock/dev-interceptors.ts"
                }
              ]
            },
            "local": {
              "optimization": false,
              "extractLicenses": false,
              "outputHashing": "none",
              "namedChunks": true,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.local.ts"
                },
                {
                  "replace": "src/app/core/interceptors/dev/dev-interceptors.ts",
                  "with": "src/app/testing/partner-mock/dev-interceptors.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "miles-masterclass-v3:build:production"
            },
            "development": {
              "buildTarget": "miles-masterclass-v3:build:development"
            },
            "local": {
              "buildTarget": "miles-masterclass-v3:build:local"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "setupFiles": ["src/test-setup.ts"]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "miles-masterclass-v3:build",
            "compodoc": false,
            "port": 6006,
            "styles": ["src/styles/styles.css", "src/styles/animation.css"]
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "miles-masterclass-v3:build",
            "compodoc": false,
            "outputDir": "storybook-static",
            "styles": ["src/styles/styles.css", "src/styles/animation.css"]
          }
        }
      }
    }
  }
}
