pnpm exec lint-staged

# Structure & modernization rules ESLint can't express (AGENTS.md §3–§4): naming, pages/,
# component CSS, static styles, @defer placeholders, token colours. Whole-repo but <1s, and a
# ratchet against structure-baseline.json, so it only fails on something new.
node scripts/check-structure.mjs

# Branch naming is part of the workflow contract (docs/engineering/git-workflow.md §2).
# Checked at commit time so a bad name surfaces before the first commit rather than
# at PR time, when renaming means re-pushing.
#
# A detached HEAD (rebase, cherry-pick, bisect) has no branch to check, so skip it —
# otherwise an interactive rebase would fail on every replayed commit.
branch=$(git symbolic-ref --quiet --short HEAD) || exit 0

case "$branch" in
  # master is listed on purpose: the manual release procedure in git-workflow.md §7
  # commits `chore(release): vX.Y.Z` directly on master.
  master | uat) exit 0 ;;
  # Bot-authored branches, so checking one out to fix its build isn't blocked.
  # Kept in step with the same list in .github/workflows/pr-title.yml.
  dependabot/* | release-please--*) exit 0 ;;
  feat/* | fix/* | chore/* | refactor/* | docs/* | test/* | style/* | perf/* | build/* | ci/* | hotfix/*) exit 0 ;;
esac

echo "✖ Branch '$branch' is not named <type>/<description>." >&2
echo "  types: feat fix chore refactor docs test style perf build ci hotfix" >&2
echo "  e.g.   feat/MIL-231-seat-allocation" >&2
echo "  see    docs/engineering/git-workflow.md §2" >&2
exit 1
