{
  "name": "miles-masterclass-v3",
  "version": "3.0.1",
  "scripts": {
    "ng": "ng",
    "generate:version": "node scripts/generate-version.mjs",
    "prestart": "pnpm run generate:version",
    "prestart:dev": "pnpm run generate:version",
    "prestart:prod": "pnpm run generate:version",
    "prebuild": "pnpm run generate:version",
    "prebuild:dev": "pnpm run generate:version",
    "prebuild:prod": "pnpm run generate:version",
    "start": "rm -rf .angular && ng serve --port 4101 --configuration local",
    "start:dev": "rm -rf .angular && ng serve --port 4101 --configuration development",
    "start:prod": "rm -rf .angular && ng serve --port 4101 --configuration production",
    "build": "ng build --configuration local",
    "build:dev": "ng build --configuration development",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration local",
    "watch:dev": "ng build --watch --configuration development",
    "watch:prod": "ng build --watch --configuration production",
    "test": "ng test",
    "pretest": "pnpm run generate:version",
    "clean": "rm -rf .angular && rm -rf dist && rm -rf node_modules && pnpm i",
    "serve:ssr:miles-masterclass-v3": "node dist/miles-masterclass-v3/server/server.mjs",
    "prepare": "husky && pnpm run generate:version",
    "lint": "ng lint",
    "prelint": "pnpm run generate:version",
    "lint:fix": "ng lint --fix",
    "format": "prettier --check \"src/**/*.{ts,html,css,scss,json,md}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,html,css,scss,json,md}\"",
    "storybook": "ng run miles-masterclass-v3:storybook",
    "build-storybook": "ng run miles-masterclass-v3:build-storybook"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "lint-staged": {
    "*.{ts,html}": "eslint --fix",
    "*.{ts,html,css,scss,json,md}": "prettier --write"
  },
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@12.5.1",
  "dependencies": {
    "@angular/animations": "^22.0.7",
    "@angular/cdk": "^22.0.5",
    "@angular/common": "^22.0.7",
    "@angular/compiler": "^22.0.7",
    "@angular/core": "^22.0.7",
    "@angular/forms": "^22.0.7",
    "@angular/platform-browser": "^22.0.7",
    "@angular/platform-server": "^22.0.7",
    "@angular/router": "^22.0.7",
    "@angular/ssr": "^22.0.7",
    "@code_with_sachin/ngx-gsap": "^0.1.0",
    "@code_with_sachin/ngx-motion": "^0.1.0",
    "@floating-ui/dom": "^1.8.0",
    "@milesverse/sdk": "^0.1.0",
    "@supabase/supabase-js": "^2.98.0",
    "@types/video.js": "^7.3.58",
    "@videojs/http-streaming": "^3.17.2",
    "@zoom/meetingsdk": "^6.2.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "gsap": "^3.15.0",
    "html2canvas-pro": "^2.0.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lenis": "^1.3.26",
    "motion": "^12.43.0",
    "ng-primitives": "^0.131.0",
    "ngx-cookie-service": "^22.0.0",
    "ngx-cookie-service-ssr": "^22.0.0",
    "rxjs": "~7.8.0",
    "swiper": "^12.0.3",
    "tailwind-merge": "^3.4.0",
    "three": "^0.186.0",
    "tslib": "^2.3.0",
    "video.js": "^8.24.1",
    "videojs-youtube": "^3.0.1"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2200.7",
    "@angular-devkit/build-angular": "^22.0.7",
    "@angular-devkit/core": "^22.0.7",
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.7",
    "@angular/platform-browser-dynamic": "22.0.7",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@ng-icons/bootstrap-icons": "^33.0.0",
    "@ng-icons/core": "^33.0.0",
    "@ng-icons/font-awesome": "^33.0.0",
    "@ng-icons/heroicons": "^33.0.0",
    "@ng-icons/lucide": "^33.0.0",
    "@ng-icons/material-icons": "^33.0.0",
    "@ng-icons/phosphor-icons": "^33.0.0",
    "@ng-icons/svgl": "^33.0.0",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/addon-onboarding": "^10.5.3",
    "@storybook/angular": "^10.5.3",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.20.1",
    "@types/three": "0.186.0",
    "angular-eslint": "22.1.0",
    "eslint": "^10.0.3",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-storybook": "^10.5.3",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.2",
    "storybook": "^10.5.3",
    "tailwindcss": "^4.1.12",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "^4.0.8"
  }
}
