{
  "name": "miles-masterclass-v3",
  "version": "3.0.1",
  "scripts": {
    "ng": "ng",
    "generate:version": "node scripts/generate-version.mjs",
    "prestart": "pnpm run generate:version",
    "prestart:dev": "pnpm run generate:version",
    "prestart:prod": "pnpm run generate:version",
    "prebuild": "pnpm run generate:version",
    "prebuild:dev": "pnpm run generate:version",
    "prebuild:prod": "pnpm run generate:version",
    "start": "rm -rf .angular && ng serve --port 4100 --configuration local",
    "start:dev": "rm -rf .angular && ng serve --port 4100 --configuration development",
    "start:prod": "rm -rf .angular && ng serve --port 4100 --configuration production",
    "build": "ng build --configuration local",
    "build:dev": "ng build --configuration development",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration local",
    "watch:dev": "ng build --watch --configuration development",
    "watch:prod": "ng build --watch --configuration production",
    "test": "ng test",
    "clean": "rm -rf .angular && rm -rf dist && rm -rf node_modules && pnpm i",
    "serve:ssr:miles-masterclass-v3": "node dist/miles-masterclass-v3/server/server.mjs",
    "prepare": "husky",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --check \"src/**/*.{ts,html,css,scss,json,md}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,html,css,scss,json,md}\""
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "lint-staged": {
    "*.{ts,html}": "eslint --fix",
    "*.{ts,html,css,scss,json,md}": "prettier --write"
  },
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@angular/aria": "^22.1.5",
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/platform-server": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@angular/ssr": "^22.1.7",
    "@code_with_sachin/ngx-gsap": "^0.1.0",
    "@code_with_sachin/ngx-motion": "^0.1.0",
    "@floating-ui/dom": "^1.8.0",
    "@milesverse/sdk": "^0.1.0",
    "@supabase/supabase-js": "^2.114.0",
    "@types/video.js": "^7.3.58",
    "@videojs/http-streaming": "^3.17.5",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "gsap": "^3.15.0",
    "html2canvas-pro": "^2.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lenis": "^1.3.26",
    "motion": "^13.2.0",
    "ng-primitives": "^0.130.2",
    "ngx-cookie-service": "^22.0.0",
    "ngx-cookie-service-ssr": "^22.0.0",
    "rxjs": "~7.8.2",
    "swiper": "^14.2.0",
    "tailwind-merge": "^3.6.0",
    "tslib": "^2.8.1",
    "video.js": "^8.24.0",
    "videojs-youtube": "^3.0.1"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2201.7",
    "@angular-devkit/core": "^22.1.7",
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@eslint/js": "^10.0.1",
    "@ng-icons/bootstrap-icons": "^36.0.0",
    "@ng-icons/core": "^36.0.0",
    "@ng-icons/font-awesome": "^36.0.0",
    "@ng-icons/heroicons": "^36.0.0",
    "@ng-icons/lucide": "^36.0.0",
    "@ng-icons/material-icons": "^36.0.0",
    "@ng-icons/phosphor-icons": "^36.0.0",
    "@ng-icons/svgl": "^36.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "angular-eslint": "22.2.0",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
